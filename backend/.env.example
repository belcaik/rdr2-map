# Export variables in your shell; backend does not load .env files.
# Relative paths resolve against the process working directory; prefer absolute paths.
HOST=127.0.0.1
PORT=3001
DB_PATH=/absolute/path/to/rdr2.db
DATA_ROOT=/absolute/path/to/data
TILES_DIR=/absolute/path/to/tiles

# To serve the production frontend from the API:
# STATIC_ROOT=/absolute/path/to/frontend/dist
